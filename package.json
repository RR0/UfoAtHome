{
  "name": "@rr0/ufoathome",
  "type": "module",
  "version": "0.38.0",
  "description": "UFO@home — record and replay a UFO sighting's shape, movement and appearance",
  "author": "Jérôme Beau <rr0@rr0.org> (https://rr0.org)",
  "license": "MIT",
  "homepage": "https://github.com/RR0/UfoAtHome#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RR0/UfoAtHome.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./ufo": "./dist-embed-ufo/rr0-ufo.mjs",
    "./recorder": "./dist-embed/rr0-ufo-recorder.mjs",
    "./scene": "./dist-embed-scene/rr0-scene.mjs",
    "./eyewitness": "./dist-embed-eyewitness/rr0-eyewitness.mjs"
  },
  "files": [
    "dist-embed",
    "dist-embed-ufo",
    "dist-embed-scene",
    "dist-embed-eyewitness"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:embed": "tsc --noEmit && vite build --config vite.embed.config.ts",
    "build:embed-ufo": "tsc --noEmit && vite build --config vite.embed-ufo.config.ts",
    "build:embed-scene": "tsc --noEmit && vite build --config vite.embed-scene.config.ts",
    "build:embed-eyewitness": "tsc --noEmit && vite build --config vite.embed-eyewitness.config.ts",
    "build:all": "npm run build && npm run build:embed && npm run build:embed-ufo && npm run build:embed-scene && npm run build:embed-eyewitness",
    "build:site": "npm run build:embed && npm run build:embed-ufo && npm run build:embed-scene && npm run build:embed-eyewitness && vite build --config vite.site.config.ts && tsx site/build.ts",
    "site": "tsx site/build.ts",
    "site:watch": "node --watch-path=./site --watch-path=./public/demo-data --import tsx site/build.ts",
    "site:serve": "vite preview --outDir dist-site --port 5181 --strictPort",
    "prepublishOnly": "npm run build:embed && npm run build:embed-ufo && npm run build:embed-scene && npm run build:embed-eyewitness && npm test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:stars": "tsx scripts/build-star-catalog.ts",
    "build:comets": "tsx scripts/build-comet-catalog.ts",
    "build:satellites": "tsx scripts/build-satellite-catalog.ts"
  },
  "dependencies": {
    "@rr0/data": "^0.3.41",
    "@rr0/place": "^0.5.4",
    "@rr0/time": "^0.11.2",
    "astronomy-engine": "^2.1.19",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@types/three": "^0.185.3",
    "codemirror": "^6.0.2",
    "jsdom": "^25.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "ufo",
    "sighting",
    "web-component",
    "rr0"
  ],
  "publishConfig": {
    "access": "public"
  }
}
