{
  "name": "@rr0/ufoathome",
  "type": "module",
  "version": "0.103.0",
  "description": "UFO@home — record and replay a UFO sighting's shape, movement and appearance",
  "author": "Jérôme Beau <rr0@rr0.org> (https://rr0.org)",
  "license": "MIT",
  "homepage": "https://ufoathome.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RR0/UfoAtHome.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./scene": "./dist-embed-scene/rr0-scene.mjs",
    "./sighting": "./dist-embed-sighting/rr0-sighting.mjs",
    "./editor": "./dist-embed-sighting-editor/rr0-sighting-editor.mjs",
    "./eyewitness": "./dist-embed-sighting/rr0-sighting.mjs",
    "./recorder": "./dist-embed-sighting-editor/rr0-sighting-editor.mjs"
  },
  "files": [
    "dist-embed-scene",
    "dist-embed-sighting",
    "dist-embed-sighting-editor"
  ],
  "scripts": {
    "predev": "npm run build:schema",
    "dev": "vite",
    "prebuild": "npm run build:schema",
    "build": "tsc --noEmit && vite build",
    "build:embed-scene": "tsc --noEmit && vite build --config vite.embed-scene.config.ts",
    "build:embed-sighting": "tsc --noEmit && vite build --config vite.embed-sighting.config.ts",
    "build:all": "npm run build:schema && npm run build && npm run build:embed-sighting-editor && npm run build:embed-scene && npm run build:embed-sighting",
    "build:site": "npm run build:schema && npm run build:embed-sighting-editor && npm run build:embed-scene && npm run build:embed-sighting && vite build --config vite.site.config.ts && tsx site/build.ts",
    "site": "tsx site/build.ts",
    "site:watch": "node --watch-path=./site --watch-path=./public/demo-data --import tsx site/build.ts",
    "site:serve": "vite preview --outDir dist-site --port 5181 --strictPort",
    "prepublishOnly": "npm run build:schema && npm run build:embed-sighting-editor && npm run build:embed-scene && npm run build:embed-sighting && npm test",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:render": "node scripts/perf/star-quality.mjs",
    "build:stars": "tsx scripts/build-star-catalog.ts",
    "build:comets": "tsx scripts/build-comet-catalog.ts",
    "build:novae": "node scripts/build-nova-catalog.ts",
    "build:sky-reference": "tsx scripts/build-sky-reference.ts",
    "build:satellites": "tsx scripts/build-satellite-catalog.ts",
    "build:schema": "tsx scripts/build-sighting-schema.ts",
    "build:lunar-limb": "tsx scripts/build-lunar-limb.ts",
    "sync:cases": "tsx scripts/sync-case-recordings.ts",
    "pretest": "npm run build:schema",
    "build:embed-sighting-editor": "npm run build:schema && tsc --noEmit && vite build --config vite.embed-sighting-editor.config.ts",
    "build:tle": "node scripts/build-tle-archive.ts",
    "build:roads": "tsx scripts/build-road-archive.ts",
    "build:light-pollution": "node --import tsx scripts/build-light-pollution-tiles.ts",
    "build:reentries": "node --import tsx scripts/build-reentry-catalog.ts",
    "build:fireballs": "node --import tsx scripts/build-fireball-archive.ts",
    "build:aircraft": "node --import tsx scripts/build-aircraft-archive.ts",
    "build:aircraft-demo": "node --import tsx scripts/build-aircraft-demo-slice.ts",
    "fetch:aircraft": "node --import tsx scripts/fetch-aircraft-release.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@rr0/data": "^0.3.49",
    "@rr0/place": "^0.5.4",
    "@rr0/time": "^2.2.0",
    "astronomy-engine": "^2.1.19",
    "satellite.js": "6.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@types/three": "^0.185.3",
    "ajv": "^8.20.0",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "jsdom": "^25.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "ufo",
    "sighting",
    "web-component",
    "rr0"
  ],
  "publishConfig": {
    "access": "public"
  }
}
