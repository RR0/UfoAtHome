   {
    "id": "craft",
    "title": {
     "fr": "L'engin",
     "en": "The craft",
     "es": "La nave",
     "it": "Il velivolo"
    },
    "explains": [
     "ufo-1"
    ],
    "model": {
     "id": "ufoathome-socorro-craft-stanford"
    },
    "track": [
     {
      "t": 0,
      "azimuthDeg": 210.6,
      "altitudeDeg": 9.975,
      "distanceM": 1195.8,
      "sizeM": {
       "widthM": 4.07,
       "lengthM": 4.65,
       "heightM": 2.8
      },
      "attitude": {
       "headingDeg": 20
      },
      "flame": {
       "lengthM": 2.43,
       "widthM": 1.17,
       "color": "#7fc4ff",
       "tipColor": "#ff8a2b",
       "luminanceCdM2": {
        "value": 200000,
        "basis": "assumed",
        "rationale": "Nobody measured it. 20 000 cd/m² (a bright gas flame) was the first guess, and drawn through the scene's own photometry it gives a flame 1.15 m across, 1.2 km away in the daylight of 17:50, a glow of two or three pixels fainter than the sky around it: nothing a driver notices. Zamora noticed it from his car, which a flame ten times brighter, 200 000 cd/m² (the order of a rocket motor's exhaust), accounts for. So 200 000 is chosen to fit the account, and it is the account, not a measurement, that sets it."
       },
       "raisesDust": true
      }
